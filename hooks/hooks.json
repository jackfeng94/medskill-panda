{
  "description": "Medskill Panda: route slide requests to the orchestrator, hold deck builds until plan.md is approved, and check saved slides for AI slop and for numbers without a claim. Silent outside slide work.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" route_prompt.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" plan_gate.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" slop_on_save.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
