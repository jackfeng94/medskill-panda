    },
    {
      "type": "figure-text",
      "title": "The effect held across age, sex and diabetes subgroups",
      "image": "2-forest.png",
      "alt": "Forest plot",
      "credit": "Source: simulated DEMO-HF data (seed 7); Poisson rate ratios",
      "bullets": [
        "Overall rate ratio 0.75 (95% CI 0.63–0.89)",
        "Every subgroup estimate lies below 1",
        "Subgroups are exploratory"
      ],
      "split": 0.62,
      "notes": "Subgroups are exploratory; say so."
    },
    {
